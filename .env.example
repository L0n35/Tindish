# Everything here is optional — the app runs fully with no env vars
# (narration stays on local template lines, with a one-time dev-console note).
# All values are server-only and never reach the browser.

# Anthropic API key. Absent → local template narration. Invalid → degrades silently to templates.
NUXT_ANTHROPIC_API_KEY=

# Model for narration. Must support structured outputs (the default does).
# NUXT_ANTHROPIC_MODEL=claude-sonnet-4-6

# Coordinates for the decorative weather line (default: London).
# NUXT_WEATHER_LAT=51.4749
# NUXT_WEATHER_LON=-0.2010
